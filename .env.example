# GranBrain Production Environment (.env.example)
# Copy to .env on the Contabo VPS and replace ALL placeholders before running setup-vps.sh.

GRANBRAIN_USERNAME=igor
# Generate SHA-256 hex hash of your strong admin password:
#   printf '%s' 'YourStrongPassword' | sha256sum | awk '{print toupper($1)}'
GRANBRAIN_PASSWORD_HASH=REPLACE_WITH_SHA256_UPPERCASE_HEX_HASH
# Minimum 32 random characters (e.g. openssl rand -base64 48)
GRANBRAIN_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS

# Dual-subdomain Cloudflare Tunnel topology (app.<domain> -> frontend, api.<domain> -> api)
GRANBRAIN_ALLOWED_ORIGINS=https://app.example.com
GRANBRAIN_API_BASE_URL=https://api.example.com

# Cloudflare Tunnel token from Zero Trust -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_CLOUDFLARE_TUNNEL_TOKEN

# rclone Google Drive remote and sync cadence (seconds)
RCLONE_REMOTE=gdrive:GranBrainVault
RCLONE_SYNC_INTERVAL_SECONDS=120
